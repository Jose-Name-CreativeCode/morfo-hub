{
  "name": "morfo-hub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema interno de gestion para Morfo Hub.",
  "scripts": {
    "dev": "vite",
    "api:dev": "node --watch server/index.js",
    "api:start": "node server/index.js",
    "dev:full": "concurrently \"npm run api:dev\" \"npm run dev\"",
    "build": "vite build",
    "build:github-pages": "VITE_BASE_PATH=/morfo-hub/ vite build",
    "preview": "vite preview",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:firebase": "npm run build && firebase deploy",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "vite": "^7.1.4"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.11.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0"
  }
}
